#include <windows.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704b0"
        BEGIN
            VALUE "CompanyName", "nextscript"
            VALUE "FileDescription", "UVE Player"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "UVEPlayer"
            VALUE "LegalCopyright", "UVE Player – libmpv (LGPL/GPL), Qt (LGPLv3)"
            VALUE "OriginalFilename", "UVEPlayer.exe"
            VALUE "ProductName", "UVE Player"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x407, 1200
    END
END
