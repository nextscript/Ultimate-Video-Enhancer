{
  "_comment": "Plugins, die .github/workflows/build-plugin.yml baut. sourceRef: Tag oder Commit des Quellstands ({version} = Plugin-Version). player.ref: fester Player-Tag für PluginApi.h, Qt-Version und Toolchain.",
  "player": {
    "repository": "nextscript/Ultimate-Video-Enhancer",
    "ref": "uve-player-v1.2.9"
  },
  "targets": ["windows-x64", "linux-x86_64", "macos-arm64"],
  "plugins": {
    "org.uveplayer.glsl-manager": {
      "package": "GLSLManager",
      "sourceRepository": "nextscript/Ultimate-Video-Enhancer",
      "sourceRef": "glsl-manager-v{version}",
      "sourcePath": "sources/GLSLManager",
      "target": "glsl_manager",
      "packageDir": "package/GLSLManager"
    }
  }
}
